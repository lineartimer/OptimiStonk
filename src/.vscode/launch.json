{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "5000"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        },
        {
            "name": "Debug Next.js",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/frontend/node_modules/next/dist/bin/next",
            "args": [
                "dev",
                "--hostname",
                "127.0.0.1",
                "--port",
                "3000"
            ],
            "cwd": "${workspaceFolder}/frontend",
            "runtimeArgs": ["--inspect"],
            "env": {
                "BACKEND_URL": "http://127.0.0.1:5000"
            },
            "skipFiles": ["<node_internals>/**"],
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "- Local:.+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}/frontend"
            }
        }
    ],
    "compounds": [
        {
            "name": "Debug FastAPI + Next.js",
            "configurations": ["Debug FastAPI", "Debug Next.js"],
            "stopAll": true
        }
    ]
}
